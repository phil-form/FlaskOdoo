# Configuration par défaut, versionnée: aucune valeur secrète ici.
# Pour surcharger sur votre machine, créez un .env.local (git-ignoré), il gagne.

# Connexion à la base: driver://user:mdp@hote:port/base
# Le port 5435 est celui publié par docker-compose (5435 -> 5432 du conteneur).
DATABASE_URL=postgresql://app:1234@db-example:5432/app

# Mode debug: rechargement auto, pages d'erreur détaillées, Debug Toolbar,
# et la route /seed (qui n'existe QUE dans ce mode).
# À mettre à False en production.
DEBUG=True

# Signe les cookies de session et les jetons CSRF.
# En production: une valeur aléatoire, uniquement dans l'environnement.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=TestAsdf1234=

# Port d'écoute du serveur de développement (main.py)
PORT=8080

# Envoi de mails (mot de passe oublié).
# En développement: Mailpit, lancé par docker-compose. Il capture tout, n'envoie
# rien, et affiche les mails sur http://localhost:8025
# Depuis un conteneur, MAIL_HOST devient le nom du service: mailpit
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=no-reply@flaskodoo.local
# En production seulement: un vrai serveur SMTP demande TLS + des identifiants.
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=

# Durée de validité d'un lien de réinitialisation, en secondes (1h).
PASSWORD_RESET_MAX_AGE=3600

# Durée de validité d'un lien de confirmation d'adresse, en secondes (24h).
EMAIL_VERIFICATION_MAX_AGE=86400

# Verrouillage après trop d'échecs de connexion (étape 10).
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Au-delà de ce délai sans échec, le compteur repart de zéro.
LOGIN_RESET_MINUTES=60

# Limitation de débit (étape 11). RATE_LIMIT_ENABLED=False dans les tests.
RATE_LIMIT_ENABLED=True
RATE_LIMIT_GLOBAL_MAX=240
RATE_LIMIT_GLOBAL_WINDOW=60

# HTTPS local (étape 12): HTTPS=True sert en https://localhost:8080
HTTPS=False
# Nombre de proxys de confiance devant l'application (0 = aucun).
# À passer à 1 quand le WAF de l'étape 13 est devant.
TRUSTED_PROXIES=0
# Durée de vie d'une session connectée, en heures.
SESSION_HOURS=8

# JWT (étape 14). La durée de vie de l'access token est le compromis central:
# court = moins de temps pour un token volé, mais reconnexions fréquentes.
# L'étape 15 règle ça avec un refresh token.
JWT_ACCESS_MINUTES=60
JWT_SECRET=Change_me_IAmTo0W3@ke